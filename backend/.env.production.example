# Set these through EC2 environment variables, AWS Secrets Manager, or SSM Parameter Store.
SPRING_PROFILES_ACTIVE=prod
DB_HOST=your-rds-endpoint
DB_PORT=5432
DB_NAME=insurance_portal
# Optional override when extra JDBC parameters are required.
# DB_URL=jdbc:postgresql://your-rds-endpoint:5432/insurance_portal?sslmode=require
DB_USERNAME=portal_app
DB_PASSWORD=replace-with-a-secret
JWT_SECRET=replace-with-a-32-character-or-longer-secret
APP_CORS_ALLOWED_ORIGINS=https://app.example.com
APP_PRODUCT_SEED_ENABLED=false
APP_VALIDATION_DATA_ENABLED=false